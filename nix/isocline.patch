+// lambdash: without the editor the terminal is not raw, so Ctrl-C is SIGINT,
+// which a shell ignores. While reading, a handler takes it instead, and the
+// line is "\x03", as from the editor. The process may have many threads, and
+// any of them may take the signal, so the handler writes to a pipe that the
+// read waits on beside stdin (the self-pipe trick).
+#if !defined(_WIN32)
+static int getline_pipe[2] = { -1, -1 };
+static void getline_on_sigint(int signum) {
+  (void)signum;
+  int saved = errno;
+  if (getline_pipe[1] >= 0) { ssize_t n = write(getline_pipe[1], "x", 1); (void)n; }
+  errno = saved;
+}
+
+// One byte of stdin: 1, or 0 at end of input, or -1 on Ctrl-C.
+static int getline_byte(char* c) {
+  while (true) {
+    fd_set readset;
+    FD_ZERO(&readset);
+    FD_SET(0, &readset);
+    FD_SET(getline_pipe[0], &readset);
+    int top = (getline_pipe[0] > 0 ? getline_pipe[0] : 0);
+    if (select(top + 1, &readset, NULL, NULL, NULL) < 0) {
+      if (errno == EINTR) continue;  // a signal, such as SIGCHLD
+      return 0;
+    }
+    if (FD_ISSET(getline_pipe[0], &readset)) {
+      char drain[16];
+      while (read(getline_pipe[0], drain, sizeof(drain)) > 0) { }
+      return -1;
+    }
+    ssize_t n = read(0, c, 1);
+    if (n < 0 && errno == EINTR) continue;
+    return (n == 1 ? 1 : 0);
+  }
+}
+#endif
