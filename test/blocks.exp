#!/usr/bin/env expect
# Run from the repository root: it uses test/reader.sh.
# Usage: expect test/blocks.exp path/to/lambdash
# do ... end over several lines, and a block stopped part way through.
set timeout 5
set stty_init "sane"
proc fail {what} { puts "\nFAIL: $what"; exit 1 }
proc see {pattern what} {
  expect {
    -re $pattern { puts "\nPASS: $what" }
    timeout { fail "$what (timeout)" }
    eof { fail "$what (shell died)" }
  }
}
proc prompt {} { see {λ> $} "prompt" }

# λsh reads approvals from $XDG_STATE_HOME. A fresh one keeps an approved flake
# in this directory from activating, and the tests from touching real state.
set state [exec mktemp -d]
spawn env XDG_STATE_HOME=$state XDG_CONFIG_HOME=$state [lindex $argv 0]
prompt

send "do print 1;\r"
see {\.\. $} "an open block asks for more"
send "print 2;\r"
see {\.\. $} "and again"
send "print 3 end\r"
see {1\r\n2\r\n3\r\n} "the block runs when it closes"
prompt

send "with (overlay \"o\" \[set \"LSH_B\" \"in\"\]) do\r"
see {\.\. $} "with opens a block"
send "printenv LSH_B end\r"
see {in\r\n} "the layer reaches the body"
prompt

# A stopped block resumes where it stopped.
send "do ./test/reader.sh; print 9 end\r"
after 300
send "\032"
see {\[1\] stopped  do \./test/reader\.sh; print 9 end} "Ctrl-Z stops a block"
prompt
send "fg\r"
after 300
send "\004"
see {9\r\n} "fg runs the rest of the block"
prompt

# A stopped with keeps its layer when resumed.
send "with (overlay \"o\" \[set \"LSH_B\" \"in\"\]) do ./test/reader.sh; printenv LSH_B end\r"
after 300
send "\032"
see {\[1\] stopped} "Ctrl-Z stops a with block"
prompt
send "printenv LSH_B\r"
prompt
send "fg\r"
after 300
send "\004"
see {in\r\n} "fg keeps the layer"
prompt

# Ctrl-C drops what was typed, an open block too, and prompts again.
send "do print 1;\r"
see {\.\. $} "a block is open"
send "print 2;\r"
see {\.\. $} "still open"
send "\003"
prompt
send "print 5\r"
see {5\r\n} "the block is gone, and the shell reads again"
prompt
send "1 + "
send "\003"
prompt
send "2 * 3\r"
see {6\r\n} "Ctrl-C drops a partial line"
prompt
# The shell itself survives it, and a job still gets it.
send "sleep 10\r"
after 300
send "\003"
prompt
send "print 7\r"
see {7\r\n} "Ctrl-C stops a job, not the shell"
prompt

send ":q\r"
expect eof
exec rm -rf $state
puts "\nALL PASSED"
