cabal-version:   3.0
name:            lambdash
version:         0.1.0.0
synopsis:        A functional shell with composable environments
build-type:      Simple
extra-source-files: examples/metacircular.lsh

common shared
  default-language: GHC2021
  ghc-options:      -Wall

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules: Lambdash, Lambdash.Classes, Lambdash.Complete, Lambdash.Declare, Lambdash.Desugar, Lambdash.Eval, Lambdash.Help, Lambdash.Infer, Lambdash.Lines, Lambdash.Nix, Lambdash.Overlay, Lambdash.Parser, Lambdash.Process, Lambdash.Repl, Lambdash.Runtime, Lambdash.Stream, Lambdash.Syntax, Lambdash.Trust, Lambdash.TypeSyntax, Lambdash.Unify
  c-sources:       cbits/spawn.c
  build-depends:   base, async, bytestring, containers, directory, filepath, megaparsec, mtl, process, stm, text, transformers, unix

executable lambdash
  import:         shared
  hs-source-dirs: app
  main-is:        Main.hs
  build-depends:  base, directory, filepath, isocline, lambdash
  ghc-options:    -threaded

-- Job-control spike. The threaded RTS is the point of the test.
executable spike-jobs
  import:         shared
  hs-source-dirs: spike
  main-is:        Main.hs
  c-sources:      cbits/spawn.c
  build-depends:  base, unix
  ghc-options:    -threaded

test-suite unify-tests
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        UnifyTests.hs
  build-depends:  base, lambdash, transformers

test-suite infer-tests
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        InferTests.hs
  build-depends:  base, containers, lambdash, transformers

test-suite parser-tests
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        ParserTests.hs
  build-depends:  base, containers, lambdash, megaparsec

test-suite eval-tests
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        EvalTests.hs
  build-depends:  base, containers, lambdash

test-suite repl-tests
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        ReplTests.hs
  build-depends:  base, containers, directory, lambdash

test-suite pipeline-tests
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        PipelineTests.hs
  build-depends:  base, async, bytestring, containers, directory, lambdash, unix
  ghc-options:    -threaded

test-suite effect-tests
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        EffectTests.hs
  build-depends:  base, containers, lambdash, transformers

test-suite lines-tests
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        LinesTests.hs
  build-depends:  base, bytestring, lambdash, text

test-suite overlay-tests
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        OverlayTests.hs
  build-depends:  base, containers, lambdash

test-suite nix-tests
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        NixTests.hs
  build-depends:  base, bytestring, containers, lambdash
