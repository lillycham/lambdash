{
  "name": "lambdash",
  "displayName": "λsh",
  "description": "λsh (lambdash) language support: highlighting, diagnostics, hover, outline, go to definition, completion, and running files",
  "version": "0.2.0",
  "publisher": "lillycham",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lillycham/lambdash"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "lambdash",
        "aliases": [
          "λsh",
          "lambdash"
        ],
        "extensions": [
          ".lsh"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lambdash",
        "scopeName": "source.lambdash",
        "path": "./syntaxes/lambdash.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Lambdash",
      "properties": {
        "lambdash.path": {
          "type": "string",
          "default": "lambdash",
          "description": "The lambdash program that runs the language server, as a name on PATH or an absolute path."
        }
      }
    },
    "commands": [
      {
        "command": "lambdash.runFile",
        "title": "Run File",
        "category": "Lambdash",
        "icon": "$(play)"
      },
      {
        "command": "lambdash.sendSelection",
        "title": "Send Selection to the Prompt",
        "category": "Lambdash"
      },
      {
        "command": "lambdash.openPrompt",
        "title": "Open a Prompt",
        "category": "Lambdash"
      },
      {
        "command": "lambdash.restart",
        "title": "Restart the Language Server",
        "category": "Lambdash"
      }
    ],
    "keybindings": [
      {
        "command": "lambdash.sendSelection",
        "key": "shift+enter",
        "when": "editorTextFocus && editorLangId == lambdash"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "lambdash.runFile",
          "when": "resourceLangId == lambdash",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "lambdash.runFile",
          "when": "editorLangId == lambdash",
          "group": "lambdash@1"
        },
        {
          "command": "lambdash.sendSelection",
          "when": "editorLangId == lambdash",
          "group": "lambdash@2"
        }
      ],
      "commandPalette": [
        {
          "command": "lambdash.runFile",
          "when": "editorLangId == lambdash"
        },
        {
          "command": "lambdash.sendSelection",
          "when": "editorLangId == lambdash"
        }
      ]
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
